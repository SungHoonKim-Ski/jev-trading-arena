{
  "name": "jev-trading-arena",
  "version": "0.1.0",
  "private": true,
  "description": "Jev(TypeSafe System One) 기반 한국/미국 주식 모의 트레이딩 백테스트 + 랭킹",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "test": "node --test --test-reporter=spec 'test/**/*.test.ts'",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude='test/**' --test-coverage-exclude='node_modules/**' 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "collect": "node src/cli/collect.ts",
    "e2e": "playwright test",
    "build:vercel": "node scripts/build-vercel.mjs",
    "ticks": "node src/cli/ticks.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.5-r.5",
    "@libsql/client": "^0.18.0",
    "@vercel/functions": "^3.9.9",
    "fflate": "^0.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}